{
  "name": "evitaint-backend",
  "version": "1.0.0",
  "description": "EviTaint: evidence-carrying, counterfactually-verified taint analysis for JS/TS web apps",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "evitaint": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "eval": "node scripts/evaluate.js",
    "calibrate": "node scripts/calibrate.js",
    "scan": "node src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/parser": "^7.26.3",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/traverse": "^7.26.4",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  }
}
